# Copy to .env.local (git-ignored) and fill in. Never commit real values.

# CRM database connection. Must connect as crm_app (the app refuses any other role).
# Local (supabase start): postgresql://crm_app:<local password>@127.0.0.1:54322/postgres
# Production: the ERP project's pooler, transaction mode (port 6543), user crm_app.<project-ref>
CRM_DATABASE_URL=

# Microsoft 365 sign-in (Auth.js). See docs/runbooks/entra-app-registration.md.
# Without all four, the app stays locked and /signin says sign-in is not set up.
AUTH_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant id>/v2.0
